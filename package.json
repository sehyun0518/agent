{
  "name": "agent-harness",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "증거로 레이어를 잇는 선언형 에이전트 하네스 — Capability 선언 하나로 Claude Code·Codex 설정을 생성하고 정적 검증합니다",
  "scripts": {
    "validate": "node tooling/validators/validate.mjs",
    "test:contracts": "node --test tooling/validators/*.test.mjs",
    "generate": "node tooling/generators/generate.mjs",
    "vendor:check": "node tooling/vendoring/check.mjs",
    "vendor:record": "node tooling/vendoring/check.mjs --record",
    "check": "npm run validate && npm run test:contracts && npm run vendor:check && npm run lint:md && node tooling/generators/generate.mjs --check",
    "lint:md": "markdownlint-cli2",
    "step": "node tooling/briefing/cli.mjs",
    "reviews": "node tooling/briefing/reviews-cli.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "markdownlint-cli2": "0.23.2",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}

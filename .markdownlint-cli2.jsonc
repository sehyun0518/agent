// 문서 형식 검사. 이 저장소의 문서를 읽는 것은 사람보다 에이전트라서,
// 렌더링 품질이 아니라 **에이전트가 구조를 잘못 읽을 여지**만 검사한다.
//
// 켜지 않은 것과 이유 (기본값 기준 위반 수):
//   MD013 line-length            — 모델은 줄바꿈 위치를 보지 않는다 (260건)
//   MD060 table-column-style     — |---|---| 는 이 저장소 관행이다 (460건)
//   MD036 no-emphasis-as-heading — **...** 를 소제목으로 쓰는 문체다 (24건)
//   MD041 first-line-heading     — 역할 문서는 프롬프트 본문이라 제목으로 시작하지 않는다 (11건)
//
// 규칙을 더 켤 때는 "에이전트가 이것 때문에 잘못 행동하는가"로 판단한다.
{
  "globs": ["**/*.md"],
  "ignores": ["node_modules"],
  "config": {
    "default": false,

    // 블록 성격 — 복사해 쓸 설정인지 설명문인지 구분된다
    "MD040": true,

    // 구조 경계 — 빈 줄이 없으면 파서가 코드블록·목록을 문단에 흡수한다
    "MD031": true,
    "MD032": true,

    // 목록 계층 — 들여쓰기가 어긋나면 중첩을 잘못 읽는다
    "MD005": true,
    "MD007": true,
    "MD029": true,

    // 링크 — 죽은 링크를 따라가면 헛발질한다
    "MD011": true,
    "MD039": true,
    "MD042": true,
    "MD051": true,
    "MD052": true,
    "MD053": true,

    // 앵커 모호성 — 같은 제목이 둘이면 "§ X 참고"가 어디를 가리키는지 알 수 없다
    "MD024": { "siblings_only": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness/schemas/profile.schema.json",
  "title": "Profile",
  "description": "Capability에 도메인/저장소 특화 요소를 바인딩한다. kind:domain은 이 저장소의 profiles/<id>/profile.yaml, kind:repository는 소비 저장소의 .agent-harness/profile.yaml이 쓴다. 프로파일은 권한을 좁힐 수만 있고 넓힐 수 없다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "namespace"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "domain",
        "repository"
      ],
      "description": "domain은 공용 하네스가 소유하는 도메인 바인딩(예: frontend). repository는 소비 저장소가 소유하는 로컬 설정."
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "이 프로파일이 만들 수 있는 확장 토큰 접두사. 코어 어휘에 등록하지 않고 <namespace>:<token>을 자유롭게 쓴다."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "default": [],
      "description": "프로파일이 소유한 에이전트. Capability에 속하지 않는 도메인 전용 역할.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "tools",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "file": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "modelTier": {
            "enum": [
              "cheap",
              "strong",
              "inherit"
            ],
            "default": "inherit"
          },
          "background": {
            "type": "boolean",
            "default": false
          },
          "isolation": {
            "enum": [
              "none",
              "worktree"
            ],
            "default": "none"
          },
          "readonly": {
            "type": "boolean",
            "default": false
          },
          "scope": {
            "type": "string",
            "description": "이 에이전트가 수정해도 되는 범위. 예: accessibility는 a11y 범위만."
          },
          "memory": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "mcpServers": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "default": []
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "default": [],
      "description": "Capability에 주입할 것. 대상 Capability의 profileExtensible이 허용한 축만 가능하다.",
      "items": {
        "type": "object",
        "required": [
          "capability"
        ],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": [],
            "description": "항상 함께 주입되는 스킬."
          },
          "skillsOneOf": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "택일 주입. 실행 시 타깃 판별로 하나만 고른다. 혼용을 금지해야 하는 규칙 팩에 쓴다(예: react-best-practice vs react-native-skills).",
            "minItems": 2
          },
          "hooks": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": [
                "event",
                "file"
              ],
              "additionalProperties": false,
              "properties": {
                "event": {
                  "enum": [
                    "before-capability",
                    "after-capability",
                    "before-tool",
                    "after-tool",
                    "on-evidence",
                    "on-failure"
                  ]
                },
                "file": {
                  "type": "string"
                },
                "blocking": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": [],
            "description": "Capability 에이전트에 더할 도메인 도구. permissions 상한을 넘으면 검증기가 거부한다."
          },
          "mcpServers": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "default": [],
            "description": "도메인 전용 MCP 서버. 예: 웹 E2E의 playwright."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "roster": {
      "type": "array",
      "default": [],
      "description": "generic 작업 단위를 명명된 실행자에 연결한다. 오케스트레이터는 이 표를 통해서만 실행자 이름을 안다.",
      "items": {
        "type": "object",
        "required": [
          "unit",
          "runner"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "type": "string",
            "description": "generic 단위 종류."
          },
          "runner": {
            "type": "string",
            "description": "capability id, <capability>#<variant>, 또는 프로파일 agent id."
          },
          "stage": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "workflowExtensions": {
      "type": "array",
      "default": [],
      "description": "core 워크플로에 도메인 단계를 끼워 넣는다. 순서의 단일 출처는 워크플로이고, 프로파일은 삽입 지점만 선언한다 — 경쟁하는 순서 정의를 두지 않기 위해서다.",
      "items": {
        "type": "object",
        "required": [
          "workflow",
          "insert"
        ],
        "additionalProperties": false,
        "properties": {
          "workflow": {
            "type": "string",
            "pattern": "^(\\*|[a-z][a-z0-9-]*)$",
            "description": "대상 워크플로 id. '*'면 모든 워크플로."
          },
          "insert": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "runner",
                "mode",
                "anchorCapability",
                "evidence",
                "completion"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "runner": {
                  "type": "string",
                  "description": "프로파일 agent id 또는 <capability>[#<variant>]."
                },
                "mode": {
                  "enum": [
                    "parallel-with",
                    "before",
                    "after"
                  ],
                  "description": "anchor 단계에 대해 어디에 놓을지."
                },
                "anchorCapability": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "이 Capability를 쓰는 step에 붙는다. step id가 아니라 Capability로 앵커하는 이유는 워크플로마다 step 이름이 다르기 때문이다(change는 implementation, bugfix는 fix). 대상 워크플로에 그 Capability가 없으면 이 삽입은 건너뛴다 — 그 흐름에는 해당 단계가 없다는 뜻이다."
                },
                "anchorStep": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "같은 Capability를 쓰는 step이 둘 이상일 때 어느 것인지 지정한다."
                },
                "produces": {
                  "type": "array",
                  "default": [],
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/token"
                  },
                  "description": "이 단계가 만드는 신호·아티팩트. 도메인 것이면 프로파일 네임스페이스를 붙인다."
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "description": "이 단계가 반드시 기록할 증거. 삽입 단계도 증거로 완료를 판정한다 (ADR-0017).",
                  "items": {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "$ref": "#/$defs/evidenceKind"
                      },
                      "required": {
                        "type": "boolean",
                        "default": true
                      },
                      "artifactRequired": {
                        "type": "boolean",
                        "default": false,
                        "description": "true면 status만으로 부족하고 원본 경로를 반드시 남겨야 한다."
                      }
                    }
                  }
                },
                "completion": {
                  "type": "object",
                  "required": [
                    "requiresEvidence"
                  ],
                  "additionalProperties": false,
                  "description": "완료 조건. 상태가 아니라 증거로 판정한다.",
                  "properties": {
                    "requiresEvidence": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/evidenceKind"
                      },
                      "description": "evidence[].kind의 부분집합이어야 한다."
                    }
                  }
                },
                "skippable": {
                  "type": "object",
                  "required": [
                    "evidenceOnSkip"
                  ],
                  "additionalProperties": false,
                  "description": "생략 가능한 단계. 침묵 생략은 금지하고 사유를 증거로 남기게 한다.",
                  "properties": {
                    "evidenceOnSkip": {
                      "$ref": "#/$defs/evidenceKind",
                      "description": "생략 시 반드시 기록할 증거."
                    },
                    "reasonRequired": {
                      "type": "boolean",
                      "default": true
                    },
                    "approvalRequired": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                },
                "background": {
                  "type": "boolean",
                  "default": false
                },
                "isolation": {
                  "enum": [
                    "none",
                    "worktree"
                  ],
                  "default": "none"
                },
                "note": {
                  "type": "string"
                }
              },
              "description": "삽입 단계 하나. 순서는 워크플로가 소유하고 이 단계의 계약은 여기가 소유한다 (ADR-0017)."
            }
          }
        }
      }
    },
    "routing": {
      "type": "array",
      "default": [],
      "description": "증상 → 소유자. 피드백 단계가 직접 고치지 않고 되돌릴 대상을 정한다.",
      "items": {
        "type": "object",
        "required": [
          "symptom",
          "owner"
        ],
        "additionalProperties": false,
        "properties": {
          "symptom": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "exception": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "description": "저장소 종속 명령. 공용 하네스는 명령 문자열을 담지 않는다. Capability variant의 commandKey가 여기를 찾는다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "default": {}
    },
    "testing": {
      "type": "object",
      "description": "테스트 계층별 라이브러리 계약. repository 프로파일의 계층 선언은 domain 기본값과 합치지 않고 해당 계층 전체를 대체한다.",
      "additionalProperties": false,
      "required": [
        "layers"
      ],
      "properties": {
        "layers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "unit": {
              "$ref": "#/$defs/testLayer"
            },
            "ui": {
              "$ref": "#/$defs/testLayer"
            },
            "integration": {
              "$ref": "#/$defs/testLayer"
            },
            "e2e": {
              "$ref": "#/$defs/testLayer"
            }
          }
        }
      }
    },
    "conventions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "description": "컨벤션 문서 경로. 내용을 프로파일에 인라인하지 않고 참조만 한다."
    },
    "knowledge": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "string"
      },
      "description": "느리게 변하는 도메인 상수 문서 참조. 예: design → ./knowledge/DESIGN.md"
    },
    "permissions": {
      "type": "object",
      "description": "권한 축소만 가능하다. Capability나 불변 정책보다 넓게 선언하면 검증기가 거부한다.",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "enum": [
            "none",
            "read",
            "write"
          ]
        },
        "network": {
          "enum": [
            "none",
            "allowlist",
            "any"
          ]
        },
        "networkAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destructive": {
          "type": "boolean"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commitConvention": {
          "type": "string"
        },
        "automaticAttribution": {
          "enum": [
            "forbidden",
            "allowed"
          ],
          "default": "forbidden",
          "description": "커밋·PR에 자동화 도구 출처 문구를 넣을지. 기본은 금지."
        },
        "prTemplate": {
          "type": "string"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "코어 관측 이벤트 → 이 저장소의 이벤트 이름 매핑. Adapter가 소비한다."
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "testLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "이 계층이 쓰는 테스트 라이브러리. manual 계층에는 없다."
        },
        "filePatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        },
        "manual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "procedure",
            "reason"
          ],
          "description": "러너를 둘 수 없는 계층. 이 계층의 증거는 test.<layer>.manual-result로 남는다.",
          "properties": {
            "procedure": {
              "type": "string",
              "minLength": 1,
              "description": "따라야 할 흐름 문서의 경로 또는 glob. 다음 사람이 같은 확인을 재현할 수 있어야 한다."
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "왜 러너를 두지 않는가. \"환경 비용\" 수준이 아니라 무엇이 필요한데 왜 없는지."
            }
          }
        }
      },
      "description": "계층 하나의 검증 수단. 러너를 두거나(libraries), 러너를 둘 수 없어 문서화된 수동 절차로 검증하거나(manual) 둘 중 하나다. 둘 다 적는 것은 모순이다 — 러너가 있으면 그것을 쓴다 (ADR-0013).",
      "anyOf": [
        {
          "required": [
            "libraries"
          ]
        },
        {
          "required": [
            "manual"
          ]
        }
      ]
    },
    "token": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "evidenceKind": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    }
  },
  "allOf": [
    {
      "$comment": "저장소 프로파일은 명령·컨벤션·권한 축소가 주 역할이다. 워크플로 순서에는 손대지 않는다.",
      "if": {
        "properties": {
          "kind": {
            "const": "repository"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "workflowExtensions"
          ]
        }
      }
    }
  ]
}

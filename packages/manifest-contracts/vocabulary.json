{
  "$comment": "docs/vocabulary.md의 기계 판독본. 두 파일은 항상 함께 갱신한다. 검증기는 이 파일을 읽어 접두사 없는(코어) 토큰의 등록 여부를 검사한다.",
  "version": 1,
  "tokenPattern": "^([a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
  "evidenceKindPattern": "^([a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
  "signals": {
    "requirements.completed": {
      "producedBy": "requirements"
    },
    "specification.completed": {
      "producedBy": "specification"
    },
    "implementation.completed": {
      "producedBy": "implementation"
    },
    "review.completed": {
      "producedBy": "review"
    }
  },
  "artifacts": {
    "requirements.spec": {
      "producedBy": "requirements"
    },
    "specification.contract": {
      "producedBy": "specification"
    },
    "specification.testids": {
      "producedBy": "specification"
    },
    "implementation.patch": {
      "producedBy": "implementation"
    },
    "implementation.summary": {
      "producedBy": "implementation"
    },
    "review.verdict": {
      "producedBy": "review"
    }
  },
  "evidence": {
    "completeness-check": {
      "statuses": [
        "passed",
        "failed"
      ]
    },
    "changed-files": {
      "statuses": [
        "recorded"
      ]
    },
    "contract-diff": {
      "statuses": [
        "recorded",
        "violated"
      ]
    },
    "review-findings": {
      "statuses": [
        "recorded"
      ]
    },
    "policy-decision": {
      "statuses": [
        "allowed",
        "denied"
      ]
    }
  }
}
